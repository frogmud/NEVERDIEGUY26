    },
    {
      "id": "cb-clausen-1hqscu",
      "text": "Smug looks good on you now, Doctor, but smugness is just testimony waiting to be impeached. One win doesn't make precedent - it makes you a suspect with better lighting. I've read case files with more integrity than that clutch roll, and I've still got a briefcase full of witnesses who'd love to cross-examine your luck.",
      "speaker": {
        "slug": "clausen",
        "name": "Detective Clausen",
        "category": "travelers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "pleased",
      "moodIntensity": 0,
      "contextTags": [
        "weather:void"
      ],
      "triggers": {
        "playerArchetype": "chaotic"
      },
      "metrics": {
