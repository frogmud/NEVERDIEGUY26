        "extractedDay": 30,
        "extractedAt": "2026-07-09T01:48:12.461Z",
        "version": 1
      }
    },
    {
      "id": "cb-dr-voss-lvn5p2",
      "text": "Two losses in a row is just a small sample size, Willy. Your smugness is a variable, not a constant. Roll again, let's see what the data actually says about your luck.",
      "speaker": {
        "slug": "dr-voss",
        "name": "Dr. Voss",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "threatening",
      "moodIntensity": -2,
      "contextTags": [
