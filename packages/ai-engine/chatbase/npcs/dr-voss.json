        "extractedAt": "2026-07-09T01:48:12.464Z",
        "version": 1
      }
    },
    {
      "id": "cb-dr-voss-q1nuuq",
      "text": "Detective Clausen, one loss shy of my mercy threshold and I intend to stay there. Call it a winning streak if you like, I call it a controlled sample size.",
      "speaker": {
        "slug": "dr-voss",
        "name": "Dr. Voss",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "sad",
      "moodIntensity": 0,
      "contextTags": [],
      "metrics": {
