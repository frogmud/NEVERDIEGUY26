      },
      "metrics": {
        "interestScore": 70,
        "source": "eternal_sim"
      },
      "metadata": {
        "extractedFrom": "/Users/kevin/Projects/NEVERDIEGUY26/packages/ai-engine/logs/eternal-2026-07-09T00-56-35-071Z/days/day-0032.md",
        "extractedDay": 32,
        "extractedAt": "2026-07-09T01:48:12.462Z",
        "version": 1
      }
    },
    {
      "id": "cb-dr-voss-ezao2t",
      "text": "Watching him lose again, another debt added to the pile. Your fear response is data, Stitch-Up, and right now you're generating quite a lot of it.",
      "speaker": {
        "slug": "dr-voss",
        "name": "Dr. Voss",
        "category": "wanderers"
      },
      "pool": "threat",
      "mood": "pleased",
      "moodIntensity": 1,
      "contextTags": [
        "weather:heat"
      ],
      "triggers": {
        "debtTension": "minor"
      },
      "metrics": {
