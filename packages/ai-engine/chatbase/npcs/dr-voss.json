        "extractedFrom": "/Users/kevin/Projects/NEVERDIEGUY26/packages/ai-engine/logs/eternal-2026-07-09T00-56-35-071Z/days/day-0030.md",
        "extractedDay": 30,
        "extractedAt": "2026-07-09T01:48:12.461Z",
        "version": 1
      }
    },
    {
      "id": "cb-dr-voss-523mjh",
      "text": "Two losses is a small sample, General. Your smugness has a wider error bar than my syringe. Keep gloating, I'm just tracking the curve down to your regression.",
      "speaker": {
        "slug": "dr-voss",
        "name": "Dr. Voss",
        "category": "wanderers"
      },
      "pool": "reaction",
      "mood": "threatening",
      "moodIntensity": -2,
      "contextTags": [
