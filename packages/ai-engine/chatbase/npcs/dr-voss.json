        "extractedAt": "2026-07-09T01:48:12.463Z",
        "version": 1
      }
    },
    {
      "id": "cb-dr-voss-7ermks",
      "text": "Smug looks good on you, Clausen, but so does denial. I've watched enough contracts unravel to know your paperwork always finds a loophole death likes. Roll the dice, I'll take notes on your face when you lose.",
      "speaker": {
        "slug": "dr-voss",
        "name": "Dr. Voss",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "threatening",
      "moodIntensity": 0,
      "contextTags": [],
      "metrics": {
