      "metrics": {
        "interestScore": 78,
        "source": "eternal_sim"
      },
      "metadata": {
        "extractedFrom": "/Users/kevin/Projects/NEVERDIEGUY26/packages/ai-engine/logs/eternal-2026-07-09T01-25-39-241Z/days/day-0070.md",
        "extractedDay": 70,
        "extractedAt": "2026-07-09T01:48:12.472Z",
        "version": 1
      }
    },
    {
      "id": "cb-boo-g-afffow",
      "text": "General, your boy's 125 in the hole with me and climbing. Whatever's coming, tell him to die somewhere cheaper this time.",
      "speaker": {
        "slug": "boo-g",
        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "reaction",
      "mood": "angry",
      "moodIntensity": 0,
