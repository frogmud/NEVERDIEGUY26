        "version": 1
      }
    },
    {
      "id": "cb-boo-g-5xlafi",
      "text": "Willy, that one eye's burning hotter than my neon and I love it, but 39-28 don't scare me, that's just a bigger invoice waiting to get written. Roll your streak, I'll roll mine, and whoever loses buys the next round, gold or favor, your pick, cousin.",
      "speaker": {
        "slug": "boo-g",
        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "scared",
      "moodIntensity": 0,
      "contextTags": [],
      "metrics": {
