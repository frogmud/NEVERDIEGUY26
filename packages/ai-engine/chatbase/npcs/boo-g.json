        "version": 1
      }
    },
    {
      "id": "cb-boo-g-s2to3v",
      "text": "Willy, that clutch roll's hot enough to owe taxes. One-eye's grinning like he printed his own dice, but printed dice still gotta land right.",
      "speaker": {
        "slug": "boo-g",
        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "pleased",
      "moodIntensity": 1,
      "contextTags": [],
