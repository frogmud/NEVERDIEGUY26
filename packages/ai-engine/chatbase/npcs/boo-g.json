        "extractedAt": "2026-07-09T01:48:12.473Z",
        "version": 1
      }
    },
    {
      "id": "cb-boo-g-o4bayb",
      "text": "Clutch roll, Doc, hot mood and all, don't make you paid up. Newcomer still owes me 225, you still owe King James every syllable of that book. Hell don't lose paperwork, it remixes the invoice.",
      "speaker": {
        "slug": "boo-g",
        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "pleased",
      "moodIntensity": 1,
      "contextTags": [
        "weather:death"
      ],
      "triggers": {
