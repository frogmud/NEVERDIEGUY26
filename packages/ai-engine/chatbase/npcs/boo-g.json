  "entries": [
    {
      "id": "cb-boo-g-gytbxl",
      "text": "Well look what the shadow dragged in, still two-for-oh and smiling like the bow's got no teeth behind it.",
      "speaker": {
        "slug": "boo-g",
        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "reaction",
      "mood": "neutral",
      "moodIntensity": 0,
      "contextTags": [
        "weather:dust"
      ],
      "metrics": {
