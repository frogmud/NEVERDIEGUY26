        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "scared",
      "moodIntensity": 0,
      "contextTags": [
        "weather:void"
      ],
      "metrics": {
        "interestScore": 78,
