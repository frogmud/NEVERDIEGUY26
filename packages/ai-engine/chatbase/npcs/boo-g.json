        "version": 1
      }
    },
    {
      "id": "cb-boo-g-z5ya8z",
      "text": "Bones, that whistle don't blow luck back into your dice, and 12 and 18 says Hell's got you on a payment plan too. Newcomer's 125 is still sitting pretty on my books, tilted or not. You want to tilt together, fine, but the invoice don't care about feelings, it just remixes.",
      "speaker": {
        "slug": "boo-g",
        "name": "Boo G",
        "category": "wanderers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "threatening",
      "moodIntensity": 0,
      "contextTags": [],
      "triggers": {
