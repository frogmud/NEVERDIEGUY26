    {
      "id": "cb-keith-man-cwtr5u",
      "text": "Okay, Doc, don't repeat this to the King's corona-cronies - new guy hit a personal best domain, came back like he'd just gone for milk. 1-0 on my ceelo record, one win deep, and rent still don't care. I can explain the first half of how he did it. The second half is where the screaming starts.",
      "speaker": {
        "slug": "keith-man",
        "name": "Keith Man",
        "category": "travelers"
      },
      "pool": "gamblingTrashTalk",
      "mood": "pleased",
      "moodIntensity": 1,
      "contextTags": [],
      "metrics": {
