{
  "name": "neverdieguy26",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @ndg/web dev",
    "build": "turbo build",
    "build:web": "pnpm --filter @ndg/web build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "sim:pantheon": "pnpm --filter @ndg/ai-engine sim:pantheon",
    "sim:eternal": "pnpm --filter @ndg/ai-engine sim:eternal",
    "sim:canon:day": "pnpm --filter @ndg/ai-engine sim:canon:day",
    "sim:canon:week": "pnpm --filter @ndg/ai-engine sim:canon:week",
    "sim:canon:continue": "pnpm --filter @ndg/ai-engine sim:canon:continue",
    "sim:canon:month": "pnpm --filter @ndg/ai-engine sim:canon:month",
    "sim:extract": "pnpm --filter @ndg/ai-engine sim:extract",
    "sim:chatter": "pnpm --filter @ndg/ai-engine sim:chatter",
